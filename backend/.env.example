# Every setting the server reads. Only DATABASE_URL is required.
# On a host, set these in its dashboard as environment variables or secrets;
# never commit real values.

DATABASE_URL=postgres://bag:bag@localhost/bag
# Where players reach the server. Used to build OAuth redirect URLs.
PUBLIC_URL=http://localhost:8080
# Listen address. Defaults to 0.0.0.0:$PORT (PORT defaults to 8080).
# BIND_ADDR=0.0.0.0:8080
# PORT=8080

# Name-only test login. Leave OFF on a public server.
DEV_LOGIN=true

# OAuth. Each provider turns on when both its values are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Game tuning (defaults shown).
# SESSION_DAYS=30
# ATTACK_WINDOW_SECS=300
# SHIELD_MINUTES=60
# START_GOLD=500
# MATCH_TROPHY_RANGE=200
# REQUESTS_PER_MINUTE=240
# RAIDS_PER_MINUTE=20
# TRUST_PROXY=false
# RUST_LOG=info,sqlx=warn

# Operator admin page at /admin (events, gifts, seasons, rewards). Off when
# empty; at least 20 characters. Never commit a real key.
# ADMIN_KEY=
