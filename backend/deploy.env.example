# Copy this file to `deploy.env` and fill in real values.
#
# deploy.ps1 uploads `deploy.env` to the VM and merges each KEY=value line
# ADDITIVELY into <VmPath>/server.env: only the keys listed here are added or
# updated, everything else already on the VM (DATABASE_URL, ...) stays.
# The first deploy creates the Postgres database and its DATABASE_URL on the
# VM, so you don't need to set it here.
#
# `deploy.env` is gitignored. Never commit real secrets.

# Google sign-in: Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID (Web application). Authorized redirect URI:
#   <PUBLIC_URL>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord sign-in: Discord Developer Portal > your app > OAuth2. Redirect:
#   <PUBLIC_URL>/v1/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Set automatically from -Domain (https://<domain>) or the VM address
# (http://<VmHost>:8080). Only set it to override that.
# PUBLIC_URL=

# Name-only test login. Leave off on a public server.
# DEV_LOGIN=false
